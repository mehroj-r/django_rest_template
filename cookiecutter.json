{
  "project_name": "Django REST Template",
  "project_slug": "django_rest_template",
  "distribution_name": "{{ cookiecutter.project_slug|replace('_', '-') }}",
  "docker_name_prefix": "{{ cookiecutter.project_slug|replace('_', '-') }}",
  "github_username": "your-github-username",
  "open_source_license": [
    "None",
    "MIT",
    "Apache-2.0",
    "GPL-3.0"
  ],
  "admin_ui": [
    "default",
    "django-unfold"
  ],
  "background_task": [
    "none",
    "celery",
    "django-q2"
  ],
  "_copy_without_render": [
    ".github/workflows/*.yml",
    "Justfile"
  ],
  "_extensions": [
    "jinja2_time.TimeExtension"
  ]
}
